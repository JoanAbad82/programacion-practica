{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flashcard.schema.json",
  "type": "object",
  "required": ["id","blockId","unitId","primaryConceptId","type","language","front","back","sourceVersion","conceptBankVersion","flashcardBankVersion","status"],
  "properties": {
    "id": {"type":"string","pattern":"^B[0-9]+-FC[0-9]{4}$"},
    "type": {"enum":["CD","CM","CR","EC","PX"]},
    "front": {"type":"string","minLength":1},
    "back": {"type":"string","minLength":1}
  },
  "additionalProperties": true
}
