{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question.schema.json",
  "type": "object",
  "required": [
    "id",
    "blockId",
    "unitId",
    "primaryConceptId",
    "secondaryConceptIds",
    "type",
    "difficulty",
    "language",
    "prompt",
    "options",
    "correctOptionId",
    "explanation",
    "sourceVersion",
    "conceptBankVersion",
    "testBankVersion",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^B1-Q[0-9]{4}$"
    },
    "blockId": {
      "const": "B1"
    },
    "unitId": {
      "type": "string",
      "pattern": "^U(0[1-9]|1[0-2])$"
    },
    "primaryConceptId": {
      "type": "string",
      "pattern": "^B1-U[0-9]{2}-[A-Z0-9-]+$"
    },
    "secondaryConceptIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^B1-U[0-9]{2}-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    },
    "type": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "difficulty": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "language": {
      "enum": [
        "COMMON",
        "PYTHON",
        "POWERSHELL",
        "PYTHON_POWERSHELL"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "enum": [
              "opt_1",
              "opt_2",
              "opt_3",
              "opt_4"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "correctOptionId": {
      "enum": [
        "opt_1",
        "opt_2",
        "opt_3",
        "opt_4"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "const": "BLOCK1_CANONICAL_V1.0"
    },
    "conceptBankVersion": {
      "const": "B1_CONCEPT_BANK_V1.0"
    },
    "testBankVersion": {
      "const": "BLOCK1_TEST_BANK_V1.0"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ]
    }
  },
  "additionalProperties": false
}
