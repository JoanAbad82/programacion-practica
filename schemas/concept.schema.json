{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "type": "object",
  "required": [
    "conceptId",
    "blockId",
    "unitId",
    "name",
    "definition",
    "language",
    "priority",
    "difficultyMin",
    "difficultyMax",
    "competencies",
    "sourceVersion",
    "status"
  ],
  "properties": {
    "conceptId": {
      "type": "string",
      "pattern": "^B1-U[0-9]{2}-[A-Z0-9-]+$"
    },
    "blockId": {
      "const": "B1"
    },
    "unitId": {
      "type": "string",
      "pattern": "^U(0[1-9]|1[0-2])$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "COMMON",
        "PYTHON",
        "POWERSHELL",
        "PYTHON_POWERSHELL"
      ]
    },
    "priority": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM"
      ]
    },
    "difficultyMin": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "difficultyMax": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "competencies": {
      "type": "array",
      "items": {
        "enum": [
          "R",
          "I",
          "A",
          "D"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sourceVersion": {
      "const": "BLOCK1_CANONICAL_V1.0"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ]
    }
  },
  "additionalProperties": false
}
