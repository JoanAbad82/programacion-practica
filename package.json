{
  "name": "programacion-practica",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:bootstrap": "node scripts/validate-bootstrap.mjs",
    "check": "npm run validate:bootstrap && npm run validate:content && npm run validate:study && npm run validate:quiz && npm run validate:flashcards && npm run validate:progress && npm run validate:ux && npm run validate:qa && npm run lint && npm run typecheck && npm test && npm run build && npm run qa:static-export",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:study": "node scripts/validate-study.mjs",
    "validate:quiz": "node scripts/validate-quiz.mjs",
    "validate:flashcards": "node scripts/validate-flashcards.mjs",
    "validate:progress": "node scripts/validate-progress.mjs",
    "validate:ux": "node scripts/validate-ux.mjs",
    "validate:qa": "node scripts/validate-qa.mjs",
    "qa:http": "node scripts/qa-http-smoke.mjs",
    "qa:build-surface": "node scripts/qa-build-surface.mjs",
    "qa:static-export": "node scripts/qa-static-export.mjs",
    "audit:content": "node scripts/rc1-content-audit.mjs --out qa/RC1_CONTENT_AUDIT.json",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report qa/playwright-report",
    "check:rc1": "npm run check && npm run audit:content && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
